# Copy this file to .env (git-ignored) and fill in real values.
# NEVER commit real API keys. This file only documents which variables the
# app looks for; see wta_daily/config.py for how each is resolved.

# Required only when voice.enabled: true in config.yaml
ELEVENLABS_API_KEY=

# Required only when script.generator: openai in config.yaml
OPENAI_API_KEY=

# Required only when match_provider.provider is live_tennis_api or best_of
# (with a live_tennis_api source) in config.yaml. Get a key at
# https://livetennisapi.com/subscribe/free - see README.md's "Match-data
# reliability" section for what plan tier unlocks the endpoints this
# project uses.
LIVETENNISAPI_KEY=

# Required only when match_provider.provider is api_tennis or best_of (with
# an api_tennis source) in config.yaml. Get a trial key at
# https://api-tennis.com/. Not enabled by default - see README.md's
# "Match-data reliability" section for why (a small but real match-date
# drift found during testing).
APITENNIS_KEY=

# YouTube publishing (youtube.enabled: true in config.yaml) does NOT use an
# environment variable - it uses OAuth credential *files* instead (a client
# secret plus an auto-refreshing token), since a single bearer key isn't
# how Google's YouTube Data API v3 authenticates. See
# secrets/youtube_client_secret.json / secrets/youtube_token.json
# (youtube.client_secret_path / youtube.token_path in config.yaml) and
# README.md's "YouTube publishing" section for the one-time setup.
